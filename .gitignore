# ============================================================
# Large trained model artifacts
# ============================================================

models/*.joblib
models/*.pkl

# Ignore other model registry versions/artifacts
models/registry/**/*.pkl

# Keep small metadata files
!models/training_summary.csv
!models/evaluation_results.csv
!models/best_model.txt
!models/evaluation_metadata.csv
!models/registry.json

# Keep ONLY the production LightGBM registry artifact
!models/registry/LightGBM/
!models/registry/LightGBM/v1/
!models/registry/LightGBM/v1/model.pkl

# ============================================================
# Data
#
# Most generated/historical data stays local.
# Keep the two real-time history files because GitHub Actions
# needs them between hourly runs.
# ============================================================

data/*

!data/raw/
!data/realtime/

data/raw/*
!data/raw/aqi_dataset.csv

data/realtime/*
!data/realtime/realtime_features.csv

# ============================================================
# Generated results
# ============================================================

results/*

# Keep monitoring reports if you want them visible on GitHub
!results/monitoring/
!results/monitoring/**

